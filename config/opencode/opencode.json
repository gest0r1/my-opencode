{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@khalilgharbaoui/opencode-claude-code-plugin",
    "@franlol/opencode-md-table-formatter@0.0.6",
    "octto@0.3.1",
    "opencode-openai-codex-auth"
  ],
  "model": "opencode-go/qwen3.7-plus",
  "small_model": "opencode-go/deepseek-v4-flash",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "yadisk": {
      "type": "local",
      "command": [
        "/home/guber/.local/bin/yadisk-mcp-with-env.sh"
      ],
      "enabled": true
    },
    "yonote": {
      "type": "local",
      "command": [
        "/home/guber/.local/bin/yonote-mcp-with-env.sh"
      ],
      "enabled": true,
      "env": {
        "YONOTE_API_KEY": "{env:YONOTE_API_KEY}",
        "YONOTE_BASE_URL": "https://app.yonote.ru/api"
      }
    },
    "yonote-native": {
      "type": "remote",
      "url": "https://fresh-logic.yonote.ru/api/v2/mcp",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:YONOTE_API_KEY}"
      }
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": true
    },
    "exchange": {
      "type": "remote",
      "url": "http://localhost:8001/sse",
      "enabled": true,
      "headers": {
        "X-API-Key": "x"
      }
    },
    "bitrix24": {
      "type": "remote",
      "url": "http://127.0.0.1:8081/mcp",
      "enabled": true
    },
    "1c-buddy": {
      "type": "remote",
      "url": "http://localhost:6002/mcp",
      "enabled": true,
      "oauth": {
        "redirectUri": "http://10.0.10.66:4099/mcp/oauth/callback?server=1c-buddy&directory=%2Fhome%2Fguber%2FOpencode%2Fdev"
      }
    },
    "n8n": {
      "type": "local",
      "command": [
        "node",
        "/home/guber/Opencode/dev/mcp_n8n/src/server.js"
      ],
      "enabled": true
    }
  },
  "permission": {
    "task": "deny",
    "context7_*": "deny",
    "exa_*": "deny",
    "gh_grep_*": "deny",
    "kagi_*": "deny",
    "webfetch": "deny",
    "exchange_*": "allow"
  },
  "instructions": [
    "./plugins/shell-strategy/shell_strategy.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "provider": {
    "opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Go",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1",
        "apiKey": "{env:OPENCODE_API_KEY}"
      }
    },
    "google": {
      "npm": "@ai-sdk/google",
      "name": "Google",
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      }
    },
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      }
    }
  },
  "agent": {
    "CodeReviewer": {
      "permission": {
        "doom_loop": "ask",
        "external_directory": {
          "/home/guber/.local/share/opencode/tool-output/*": "allow",
          "/tmp/opencode/*": "allow",
          "/home/guber/.agents/skills/caveman/*": "allow",
          "/home/guber/.agents/skills/find-skills/*": "allow",
          "/home/guber/.config/opencode/skills/task-management/*": "allow",
          "/home/guber/.opencode/skills/corporate-mail/*": "allow",
          "/home/guber/.opencode/skills/context7/*": "allow",
          "/home/guber/.opencode/skills/task-management/*": "allow",
          "*": "ask"
        },
        "question": "deny",
        "plan_enter": "deny",
        "plan_exit": "deny",
        "read": {
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "task": {
          "contextscout": "allow",
          "*": "deny"
        },
        "context7_*": "deny",
        "exa_*": "deny",
        "gh_grep_*": "deny",
        "kagi_*": "deny",
        "webfetch": "deny",
        "bash": "deny",
        "edit": {
          "**/*": "deny"
        },
        "write": {
          "**/*": "deny"
        }
      }
    },
    "CoderAgent": {
      "permission": {
        "doom_loop": "ask",
        "external_directory": {
          "/home/guber/.local/share/opencode/tool-output/*": "allow",
          "/tmp/opencode/*": "allow",
          "/home/guber/.agents/skills/caveman/*": "allow",
          "/home/guber/.agents/skills/find-skills/*": "allow",
          "/home/guber/.config/opencode/skills/task-management/*": "allow",
          "/home/guber/.opencode/skills/task-management/*": "allow",
          "/home/guber/.opencode/skills/context7/*": "allow",
          "/home/guber/.opencode/skills/corporate-mail/*": "allow",
          "*": "ask"
        },
        "question": "deny",
        "plan_enter": "deny",
        "plan_exit": "deny",
        "read": {
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "task": {
          "contextscout": "allow",
          "externalscout": "allow",
          "TestEngineer": "allow",
          "*": "deny"
        },
        "context7_*": "deny",
        "exa_*": "deny",
        "gh_grep_*": "deny",
        "kagi_*": "deny",
        "webfetch": "deny",
        "bash": {
          "bash .opencode/skills/task-management/router.sh complete*": "allow",
          "bash .opencode/skills/task-management/router.sh status*": "allow",
          "*": "deny"
        },
        "edit": {
          "**/*.env*": "deny",
          "**/*.key": "deny",
          "**/*.secret": "deny",
          "node_modules/**": "deny",
          ".git/**": "deny"
        }
      }
    },
    "build": {
      "permission": {
        "doom_loop": "ask",
        "external_directory": {
          "/home/guber/.local/share/opencode/tool-output/*": "allow",
          "/tmp/opencode/*": "allow",
          "/home/guber/.agents/skills/find-skills/*": "allow",
          "/home/guber/.agents/skills/caveman/*": "allow",
          "/home/guber/.config/opencode/skills/task-management/*": "allow",
          "/home/guber/.opencode/skills/task-management/*": "allow",
          "/home/guber/.opencode/skills/corporate-mail/*": "allow",
          "/home/guber/.opencode/skills/context7/*": "allow",
          "*": "ask"
        },
        "plan_exit": "deny",
        "read": {
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "task": "deny",
        "context7_*": "deny",
        "exa_*": "deny",
        "gh_grep_*": "deny",
        "kagi_*": "deny",
        "webfetch": "deny"
      }
    },
    "OpenAgent": {
      "permission": {
        "doom_loop": "ask",
        "external_directory": {
          "*": "ask",
          "/home/guber/.local/share/opencode/tool-output/*": "allow",
          "/tmp/opencode/*": "allow",
          "/home/guber/.agents/skills/caveman/*": "allow",
          "/home/guber/.agents/skills/find-skills/*": "allow",
          "/home/guber/.config/opencode/skills/task-management/*": "allow",
          "/home/guber/.opencode/skills/context7/*": "allow",
          "/home/guber/.opencode/skills/corporate-mail/*": "allow",
          "/home/guber/.opencode/skills/task-management/*": "allow"
        },
        "question": "deny",
        "plan_enter": "deny",
        "plan_exit": "deny",
        "read": {
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "task": {
          "*": "deny",
          "contextscout": "allow",
          "ContextScout": "allow",
          "externalscout": "allow",
          "ExternalScout": "allow",
          "TaskManager": "allow",
          "taskmanager": "allow",
          "DocWriter": "allow",
          "docwriter": "allow",
          "CoderAgent": "allow",
          "coderagent": "allow",
          "TestEngineer": "allow",
          "testengineer": "allow",
          "CodeReviewer": "allow",
          "codereviewer": "allow",
          "BuildAgent": "allow",
          "buildagent": "allow",
          "BatchExecutor": "allow",
          "batchexecutor": "allow"
        },
        "context7_*": "deny",
        "exa_*": "deny",
        "gh_grep_*": "deny",
        "kagi_*": "deny",
        "webfetch": "deny",
        "bash": {
          "*": "ask",
          "rm -rf *": "ask",
          "rm -rf /*": "deny",
          "sudo *": "deny",
          "> /dev/*": "deny"
        },
        "edit": {
          "**/*.env*": "deny",
          "**/*.key": "deny",
          "**/*.secret": "deny",
          "node_modules/**": "deny",
          ".git/**": "deny"
        }
      }
    }
  }
}
