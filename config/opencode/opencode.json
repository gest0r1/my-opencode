{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/qwen3.7-plus",
  "permissions": [
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "context7_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "exa_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "gh_grep_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "kagi_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "worktree_*",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "disabled": false
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp",
        "disabled": false
      },
      "yadisk": {
        "type": "local",
        "command": [
          "{env:HOME}/.local/bin/yadisk-mcp"
        ],
        "environment": {
          "YANDEX_DISK_TOKEN": "{env:YANDEX_DISK_TOKEN}",
          "YADISK_MCP_READ_ONLY": "false"
        },
        "disabled": false
      },
      "memory": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-memory"
        ],
        "disabled": false
      },
      "1c-buddy": {
        "type": "remote",
        "url": "http://localhost:6002/mcp",
        "oauth": {
          "redirect_uri": "http://10.0.10.66:4099/mcp/oauth/callback?server=1c-buddy"
        },
        "disabled": false
      }
    }
  },
  "compaction": {
    "auto": true,
    "buffer": 10000
  },
  "plugins": [
    "@openchamber/opencode-claude@1.3.4"
  ],
  "providers": {
    "openai": {
      "settings": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      }
    }
  }
}
