  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "disabled": false
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp",
        "disabled": false
      },
      "yadisk": {
        "type": "local",
        "command": [
          "{env:HOME}/.local/bin/yadisk-mcp"
        ],
        "environment": {
          "YANDEX_DISK_TOKEN": "{env:YANDEX_DISK_TOKEN}",
          "YADISK_MCP_READ_ONLY": "false"
        },
        "disabled": false
      },
      "memory": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-memory"
        ],
        "disabled": false
      },
      "1c-buddy": {
        "type": "remote",
        "url": "http://localhost:6002/mcp",
        "oauth": {
          "redirect_uri": "http://10.0.10.66:4099/mcp/oauth/callback?server=1c-buddy"
        },
        "disabled": false
      }
    }
  },
  "compaction": {
    "auto": true,
    "buffer": 10000
  },
  "instructions": [
    "./context/shell-strategy/shell_strategy.md",
    "$HOME/.agents/skills/caveman/SKILL.md"
  ],
  "plugins": [],
  "providers": {
    "openai": {
      "settings": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      }
    }
  }
}
