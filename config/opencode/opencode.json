{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@franlol/opencode-md-table-formatter@0.0.6",
    "octto@0.3.1",
    "./plugins/opencode-web-reboot"
  ],
  "model": "opencode-go/qwen3.7-plus",
  "small_model": "opencode-go/deepseek-v4-flash",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "yadisk": {
      "type": "local",
      "command": [
        "/home/guber/.local/bin/yadisk-mcp-with-env.sh"
      ],
      "enabled": true
    },
    "yonote": {
      "type": "local",
      "command": [
        "python3",
        "/home/guber/bot-project/ductor-src/runtime_site_packages/ductor_bot/_home_defaults/workspace/tools/mcp_servers/yonote_mcp.py"
      ],
      "enabled": true,
      "env": {
        "YONOTE_API_KEY": "{env:YONOTE_API_KEY}",
        "YONOTE_BASE_URL": "https://app.yonote.ru/api",
        "YONOTE_ALLOW_WRITE": "false",
        "YONOTE_REQUIRE_DRY_RUN": "true"
      }
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": true
    },
    "exchange": {
      "type": "remote",
      "url": "http://localhost:8001/sse",
      "enabled": true,
      "headers": {
        "X-API-Key": "x"
      }
    },
    "bitrix24": {
      "type": "remote",
      "url": "http://127.0.0.1:8081/mcp",
      "enabled": true
    }
  },
  "permission": {
    "task": "deny",
    "context7_*": "deny",
    "exa_*": "deny",
    "gh_grep_*": "deny",
    "kagi_*": "deny",
    "webfetch": "deny",
    "exchange_*": "allow"
  },
  "instructions": [
    "./plugins/shell-strategy/shell_strategy.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  }
}
