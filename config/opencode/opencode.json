{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@khalilgharbaoui/opencode-claude-code-plugin",
    "@franlol/opencode-md-table-formatter@0.0.6",
    "octto@0.3.1",
    "opencode-openai-codex-auth"
  ],
  "model": "opencode-go/qwen3.7-plus",
  "small_model": "opencode-go/mimo-v2.5",
  "subagent_depth": 3,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "yadisk": {
      "type": "local",
      "command": [
        "/home/guber/.local/bin/yadisk-mcp"
      ],
      "enabled": true,
      "env": {
        "YANDEX_DISK_TOKEN": "{env:YANDEX_DISK_TOKEN}",
        "YADISK_MCP_READ_ONLY": "false"
      }
    },
    "yonote": {
      "type": "remote",
      "url": "https://fresh-logic.yonote.ru/api/v2/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:YONOTE_API_KEY}"
      }
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": true
    },
    "exchange": {
      "type": "remote",
      "url": "http://localhost:8001/sse",
      "enabled": true,
      "headers": {
        "X-API-Key": "{env:EXCHANGE_MCP_API_KEY}"
      }
    },
    "bitrix24": {
      "type": "remote",
      "url": "http://127.0.0.1:8081/mcp",
      "enabled": true
    },
    "n8n": {
      "type": "local",
      "command": [
        "node",
        "/home/guber/Opencode/dev/mcp_n8n/src/server.js"
      ],
      "enabled": true,
      "env": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      }
    },
    "1c-buddy": {
      "type": "remote",
      "url": "http://localhost:6002/mcp",
      "enabled": true,
      "oauth": {
        "redirectUri": "http://10.0.10.66:4099/mcp/oauth/callback?server=1c-buddy"
      }
    },
    "itop": {
      "type": "local",
      "command": [
        "python3",
        "/home/guber/Opencode/dev/mcp-itop/server.py"
      ],
      "enabled": true,
      "env": {
        "ITOP_URL": "{env:ITOP_URL}",
        "ITOP_TOKEN": "{env:ITOP_TOKEN}",
        "ITOP_VERSION": "1.3",
        "ITOP_VERIFY_SSL": "true",
        "ITOP_TIMEOUT": "30"
      }
    },
    "google-drive": {
      "type": "local",
      "command": [
        "/home/guber/.local/bin/google-drive-mcp-wrapper.sh"
      ],
      "enabled": true,
      "env": {
        "GDRIVE_MCP_CLIENT_ID": "{env:GDRIVE_MCP_CLIENT_ID}",
        "GDRIVE_MCP_CLIENT_SECRET": "{env:GDRIVE_MCP_CLIENT_SECRET}",
        "GDRIVE_MCP_REFRESH_TOKEN": "{env:GDRIVE_MCP_REFRESH_TOKEN}"
      }
    },
    "image-gen": {
      "type": "local",
      "command": [
        "python3",
        "-m",
        "image_gen_mcp.server"
      ],
      "enabled": true,
      "env": {
        "IMAGE_GEN_OUTPUT_DIR": "/home/guber/Opencode/site_re/документация/assets"
      }
    },
    "ya-metrika": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@theyahia/yandex-metrika-mcp"
      ],
      "enabled": true,
      "env": {
        "YANDEX_METRIKA_TOKEN": "{env:YANDEX_METRIKA_TOKEN}"
      }
    }
  },
  "permission": {
    "task": "deny",
    "context7_*": "deny",
    "exa_*": "deny",
    "gh_grep_*": "deny",
    "kagi_*": "deny",
    "webfetch": "deny",
    "worktree_*": "deny",
    "exchange_*": "deny",
    "image-gen_*": "deny",
    "google-drive_*": "deny",
    "ya-metrika_*": "deny",
    "yadisk_*": "deny",
    "yonote_*": "deny",
    "memory_*": "deny",
    "bitrix24_*": "deny",
    "n8n_*": "deny",
    "1c-buddy_*": "deny",
    "itop_*": "deny"
  },
  "instructions": [
    "./plugins/shell-strategy/shell_strategy.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "provider": {
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      }
    }
  },
  "agent": {
    "build": {
      "permission": {
        "doom_loop": "ask",
        "external_directory": {
          "*": "ask",
          "/home/guber/.local/share/opencode/tool-output/*": "allow",
          "/tmp/opencode/*": "allow",
          "/home/guber/.agents/skills/find-skills/*": "allow",
          "/home/guber/.config/opencode/skills/task-management/*": "allow",
          "/home/guber/.opencode/skills/task-management/*": "allow"
        },
        "plan_exit": "deny",
        "read": {
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "task": "deny",
        "context7_*": "deny",
        "exa_*": "deny",
        "gh_grep_*": "deny",
        "kagi_*": "deny",
        "webfetch": "deny"
      }
    },
    "OpenAgent": {
      "permission": {
        "doom_loop": "ask",
        "external_directory": {
          "*": "ask",
          "/home/guber/.local/share/opencode/tool-output/*": "allow",
          "/tmp/opencode/*": "allow",
          "/home/guber/.agents/skills/find-skills/*": "allow",
          "/home/guber/.config/opencode/skills/task-management/*": "allow",
          "/home/guber/.opencode/skills/context7/*": "allow",
          "/home/guber/.opencode/skills/corporate-mail/*": "allow",
          "/home/guber/.opencode/skills/task-management/*": "allow",
          "/home/guber/.opencode/skills/telegram-send/*": "allow"
        },
        "question": "deny",
        "plan_enter": "deny",
        "plan_exit": "deny",
        "read": {
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "task": {
          "*": "deny",
          "contextscout": "allow",
          "ContextScout": "allow",
          "externalscout": "allow",
          "ExternalScout": "allow",
          "TaskManager": "allow",
          "taskmanager": "allow",
          "DocWriter": "allow",
          "docwriter": "allow",
          "CoderAgent": "allow",
          "coderagent": "allow",
          "TestEngineer": "allow",
          "testengineer": "allow",
          "CodeReviewer": "allow",
          "codereviewer": "allow",
          "BuildAgent": "allow",
          "buildagent": "allow",
          "BatchExecutor": "allow",
          "batchexecutor": "allow",
          "WebResearcher": "allow",
          "webresearcher": "allow",
          "StageOrchestrator": "allow",
          "stage-orchestrator": "allow",
          "OpenStageOrchestrator": "allow",
          "OpenDevopsSpecialist": "allow",
          "devops-specialist": "allow",
          "OpenFrontendSpecialist": "allow"
        },
        "bash": {
          "*": "ask",
          "rm -rf *": "ask",
          "rm -rf /*": "deny",
          "sudo *": "deny",
          "> /dev/*": "deny"
        },
        "edit": {
          "**/*.env*": "deny",
          "**/*.key": "deny",
          "**/*.pem": "deny",
          "**/*.secret": "deny",
          "node_modules/**": "deny",
          ".git/**": "deny"
        },
        "exchange_*": "allow",
        "image-gen_*": "allow",
        "google-drive_*": "allow",
        "ya-metrika_*": "allow",
        "yadisk_*": "allow",
        "yonote_*": "allow",
        "memory_*": "allow",
        "bitrix24_*": "allow",
        "n8n_*": "allow",
        "1c-buddy_*": "allow",
        "itop_*": "allow"
      }
    }
  }
}
