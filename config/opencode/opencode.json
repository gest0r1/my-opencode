{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/qwen3.7-plus",
  "permissions": [
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "context7_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "exa_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "gh_grep_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "kagi_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "worktree_*",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "agents": {
    "CodeReviewer": {
      "mode": "subagent"
    },
    "CoderAgent": {
      "mode": "subagent"
    },
    "build": {
      "permissions": [
        {
          "action": "doom_loop",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "external_directory",
          "resource": "$HOME/.local/share/opencode/tool-output/*",
          "effect": "allow"
        },
        {
          "action": "external_directory",
          "resource": "/tmp/opencode/*",
          "effect": "allow"
        },
        {
          "action": "external_directory",
          "resource": "$HOME/.agents/skills/find-skills/*",
          "effect": "allow"
        },
        {
          "action": "external_directory",
          "resource": "$HOME/.agents/skills/caveman/*",
          "effect": "allow"
        },
        {
          "action": "external_directory",
          "resource": "$HOME/.config/opencode/skills/task-management/*",
          "effect": "allow"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "plan_exit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env",
          "effect": "ask"
        },
        {
          "action": "read",
          "resource": "*.env.*",
          "effect": "ask"
        },
        {
          "action": "read",
          "resource": "*.env.example",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "context7_*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "exa_*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "gh_grep_*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "kagi_*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "deny"
        }
      ],
      "mode": "primary"
    },
    "OpenAgent": {
      "mode": "primary"
    },
    "title": {
      "model": "opencode-go/mimo-v2.5"
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "disabled": false
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp",
        "disabled": false
      },
      "yadisk": {
        "type": "local",
        "command": [
          "{env:HOME}/.local/bin/yadisk-mcp"
        ],
        "environment": {
          "YANDEX_DISK_TOKEN": "{env:YANDEX_DISK_TOKEN}",
          "YADISK_MCP_READ_ONLY": "false"
        },
        "disabled": false
      },
      "memory": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-memory"
        ],
        "disabled": false
      },
      "1c-buddy": {
        "type": "remote",
        "url": "http://localhost:6002/mcp",
        "oauth": {
          "redirect_uri": "http://10.0.10.66:4099/mcp/oauth/callback?server=1c-buddy"
        },
        "disabled": false
      }
    }
  },
  "compaction": {
    "auto": true,
    "buffer": 10000
  },
  "plugins": [],
  "providers": {
    "openai": {
      "settings": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      }
    }
  }
}
