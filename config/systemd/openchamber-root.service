[Unit]
Description=OpenChamber (root UI, external opencode runtime)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
# Only the shared Chats tree has the opencode group (setgid directories).
# Root-owned settings and approval secrets remain under private root-owned paths.
UMask=0002
WorkingDirectory=/root
Environment="HOME=/root" "XDG_CONFIG_HOME=/root/.config" "XDG_DATA_HOME=/root/.local/share" "XDG_STATE_HOME=/root/.local/state"
Environment="OPENCHAMBER_ROOT_MODE=separated" "OPENCHAMBER_EXECUTION_USER=opencode"
Environment="NODE_OPTIONS=--require /usr/local/lib/my-opencode/openchamber-child-boundary.cjs"
Environment="OPENCODE_HOST=http://127.0.0.1:4096" "OPENCODE_SKIP_START=true" "OPENCODE_BINARY=/usr/local/lib/my-opencode/opencode-unpriv-wrapper.sh"
Environment="OPENCHAMBER_BIND_HOST=0.0.0.0" "OPENCHAMBER_BIND_PORT=3000"
EnvironmentFile=-/root/.config/openchamber/startup.env
# The trusted root-owned split-execution settings must win over migrated startup.env.
EnvironmentFile=/etc/my-opencode/openchamber-execution.env
ExecStart=/usr/local/lib/my-opencode/launch-openchamber-root.sh /root/.local/bin/openchamber serve --host ${OPENCHAMBER_BIND_HOST} --port ${OPENCHAMBER_BIND_PORT} --foreground
TimeoutStopSec=10
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
# Root UI must traverse opencode-owned 0700 projects/Chats to read Git and
# OpenChamber project setup. Do not grant this capability to child executors.
# CHOWN: root UI prepares isolated extension Git scratch and service data.
# Neither CHOWN nor DAC_OVERRIDE is ambient; children switch to opencode.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_CHOWN
AmbientCapabilities=CAP_SETUID CAP_SETGID
PrivateTmp=true
ProtectSystem=full
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target