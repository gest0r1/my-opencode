[Unit]
Description=OpenCode Web Server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/.opencode/bin/opencode serve --port ${OPENCODE_WEB_PORT} --hostname 127.0.0.1
Environment="HOME=%h" "PATH=%h/.local/bin:%h/.opencode/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin"
Environment="XDG_CONFIG_HOME=%h/.config" "XDG_DATA_HOME=%h/.local/share" "XDG_STATE_HOME=%h/.local/state"
Environment="OPENCODE_WEB_PORT=4096"
EnvironmentFile=-%h/.config/opencode.env
TimeoutStopSec=10
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
