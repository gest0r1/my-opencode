[Unit]
Description=OpenCode Web Server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/guber
## Local plugins, including pipeline-runtime, require normal plugin loading.
ExecStart=/home/guber/.opencode/bin/opencode web --port 4096 --hostname 0.0.0.0
EnvironmentFile=/home/guber/.config/opencode.env
TimeoutStopSec=10
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
