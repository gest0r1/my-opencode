# Единое окружение OpenCode / OpenChamber
# Installer копирует этот файл в ~/.config/opencode.env.
# Секреты заполняются только на runtime-машине и не коммитятся в Git.
#
# LLM credentials (OpenCode Go / Zen / OpenAI OAuth) сюда НЕ добавлять:
# они управляются через `opencode auth login` и хранятся в
# ~/.local/share/opencode/auth.json.

# MCP / интеграционные секреты при необходимости:
# YANDEX_DISK_TOKEN=

# Локальные tools/integrations:
# TELEGRAM_BOT_TOKEN=
# GEMINI_API_KEY=
# MINIMAX_API_KEY=

# Общие runtime-настройки OpenCode.
# OPENCODE_DISABLE_DEFAULT_PLUGINS=1

# Optional: install Claude CLI for the native OpenCode V2 Claude Code provider.
# OPENCODE_INSTALL_CLAUDE_CLI=1
