# Single runtime environment for OpenCode/OpenChamber and managed 1c-buddy.
# Installer copies this template to ~/.config/opencode.env without overwriting existing values.
# Never commit real tokens or paste them in issues/logs; chmod 600 ~/.config/opencode.env.
# OpenCode provider credentials belong to `opencode auth login`, not here.

# MCP credentials; fill only on the runtime host:
# YANDEX_DISK_TOKEN=
# YANDEX_METRIKA_TOKEN=
# ONEC_AI_TOKEN=

# Optional runtime settings:
# OPENCODE_DISABLE_DEFAULT_PLUGINS=1
