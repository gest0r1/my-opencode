# Opencode Web Environment Variables
# Copy this file to ~/.config/opencode-web.env and fill in your values
OPENAI_API_KEY=sk-your-openai-key
EXA_API_KEY=your-exa-key
YONOTE_API_KEY=your-yonote-key
OPENCODE_SERVER_PASSWORD=your-web-password
YANDEX_DISK_TOKEN=your-yandex-token
OPENCODE_DISABLE_DEFAULT_PLUGINS=1
